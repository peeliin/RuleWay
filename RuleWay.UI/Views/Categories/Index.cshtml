@{
    ViewData["Title"] = "Kategoriler";
}

<section id="categoriesPage">

    <div class="page-header">
        <div>
            <h3>Kategori Yönetimi</h3>
            <p class="page-subtitle">Kategorilerinizi düzenleyin.</p>
        </div>
        <button class="btn-primary-custom" id="addCategoryBtn">
            <i class="bi bi-plus-lg"></i> Kategori Ekle
        </button>
    </div>

    <div class="data-card">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Kategori Adı</th>
                        <th>Minimum Stok</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody id="categoryTableBody"></tbody>
            </table>
        </div>
    </div>

</section>

<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal">
            <div class="modal-header">
                <h5 id="categoryModalTitle" class="modal-title">Kategori Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="categoryForm">
                <div class="modal-body">
                    <input type="hidden" id="categoryId">
                    <div class="form-item">
                        <label for="categoryName">Kategori Adı</label>
                        <input id="categoryName" type="text" required>
                    </div>
                    <div class="form-item">
                        <label for="categoryMinStock">Minimum Stok Adedi</label>
                        <input id="categoryMinStock" type="number" min="0" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn-save">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/categories.js"></script>
}
