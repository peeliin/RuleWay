@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', sans-serif;
    background-color: #f4f3f9;
    color: #1e1e2d;
    overflow: hidden;
    height: 100vh;
}

.app-layout {
    display: flex;
    height: 100vh;
}

.sidebar {
    width: 250px;
    background: linear-gradient(180deg, #2d2640 0%, #1a1528 100%);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    transition: transform 0.3s ease;
    z-index: 100;
}

.sidebar-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 28px 24px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
}

.brand-icon {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, #7c5ce0 0%, #a78bfa 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #fff;
}

.brand-text {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.3px;
}

.sidebar-nav {
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 10px;
    color: rgba(255,255,255,0.55);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s ease;
}

.nav-item i {
    font-size: 18px;
}

.nav-item:hover {
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.85);
}

.nav-item.active {
    background: linear-gradient(135deg, #7c5ce0 0%, #6a4fc9 100%);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(124,92,224,0.35);
}

.main-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.topbar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 32px;
    background: #ffffff;
    border-bottom: 1px solid #eae8f0;
}

.sidebar-toggle {
    display: none;
    background: none;
    border: 1px solid #e0dce8;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 20px;
    color: #5e5a6e;
    cursor: pointer;
}

.topbar-title {
    font-size: 18px;
    font-weight: 600;
    color: #1e1e2d;
    margin: 0;
}

.content-area {
    flex: 1;
    overflow-y: auto;
    padding: 28px 32px;
}

.page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
}

.page-header h3 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 4px;
}

.page-subtitle {
    font-size: 13px;
    color: #8b87a0;
    margin: 0;
}

.btn-primary-custom {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: linear-gradient(135deg, #7c5ce0 0%, #6a4fc9 100%);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 11px 20px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(124,92,224,0.25);
}

.btn-primary-custom:hover {
    box-shadow: 0 4px 16px rgba(124,92,224,0.4);
    transform: translateY(-1px);
}

.filter-card {
    background: #ffffff;
    border: 1px solid #eae8f0;
    border-radius: 14px;
    padding: 20px 24px;
    margin-bottom: 20px;
}

.filter-row {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    flex-wrap: wrap;
}

.filter-group {
    flex: 1;
    min-width: 140px;
}

.filter-group label {
    display: block;
    margin-bottom: 6px;
    font-size: 12px;
    font-weight: 600;
    color: #6e6a80;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}

.filter-group input {
    width: 100%;
    border: 1px solid #dddae6;
    border-radius: 9px;
    padding: 10px 13px;
    font-size: 14px;
    font-family: 'Inter', sans-serif;
    outline: none;
    transition: border-color 0.2s;
    background: #faf9fd;
}

.filter-group input:focus {
    border-color: #7c5ce0;
    background: #fff;
}

.filter-actions {
    display: flex;
    gap: 8px;
}

.btn-filter {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #7c5ce0 0%, #6a4fc9 100%);
    color: #fff;
    border: none;
    border-radius: 9px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
}

.btn-clear {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #f0eef5;
    color: #5e5a6e;
    border: none;
    border-radius: 9px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
}

.btn-clear:hover {
    background: #e5e2ed;
}

.data-card {
    background: #ffffff;
    border: 1px solid #eae8f0;
    border-radius: 14px;
    overflow: hidden;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
}

.data-table th {
    background: #f8f7fc;
    color: #7c789a;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 14px 18px;
    border-bottom: 1px solid #eae8f0;
    text-align: left;
}

.data-table td {
    padding: 14px 18px;
    border-bottom: 1px solid #f2f1f6;
    vertical-align: middle;
    font-size: 14px;
}

.data-table tr:last-child td {
    border-bottom: none;
}

.data-table tr:hover td {
    background: #fbfafd;
}

.product-thumb {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid #eae8f0;
}

.product-thumb-placeholder {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: #f0eef5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #b5b0c8;
    font-size: 20px;
    border: 1px solid #eae8f0;
}

.product-info .product-name {
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 2px;
    color: #1e1e2d;
}

.product-info .product-desc {
    font-size: 12px;
    color: #8b87a0;
    max-width: 280px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.badge-live {
    display: inline-block;
    background: #e6f9ee;
    color: #1b7a43;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.badge-offline {
    display: inline-block;
    background: #fef0f0;
    color: #c04848;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.action-btn {
    border: none;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: 'Inter', sans-serif;
}

.action-btn.edit {
    background: #eeebfb;
    color: #6a4fc9;
}

.action-btn.edit:hover {
    background: #e0dbf5;
}

.action-btn.delete {
    background: #fef0f0;
    color: #c04848;
    margin-left: 6px;
}

.action-btn.delete:hover {
    background: #fce0e0;
}

.pagination-area {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-top: 1px solid #f2f1f6;
}

.page-info {
    font-size: 13px;
    color: #8b87a0;
    font-weight: 500;
}

.pagination-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border: 1px solid #dddae6;
    background: #fff;
    color: #5e5a6e;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: all 0.15s ease;
}

.pagination-btn:hover:not(:disabled) {
    border-color: #7c5ce0;
    color: #7c5ce0;
}

.pagination-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
}

.empty-row {
    text-align: center;
    color: #8b87a0;
    padding: 48px 20px !important;
    font-size: 14px;
}

.custom-modal {
    border: none;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.15);
}

.custom-modal .modal-header {
    border-bottom: 1px solid #eae8f0;
    padding: 20px 24px;
}

.custom-modal .modal-title {
    font-size: 17px;
    font-weight: 700;
}

.custom-modal .modal-body {
    padding: 24px;
}

.custom-modal .modal-footer {
    border-top: 1px solid #eae8f0;
    padding: 16px 24px;
}

.form-item {
    margin-bottom: 16px;
}

.form-item label {
    display: block;
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #5e5a6e;
}

.form-item input,
.form-item textarea,
.form-item select {
    width: 100%;
    border: 1px solid #dddae6;
    border-radius: 9px;
    padding: 10px 13px;
    font-size: 14px;
    font-family: 'Inter', sans-serif;
    outline: none;
    transition: border-color 0.2s;
    background: #faf9fd;
}

.form-item input:focus,
.form-item textarea:focus,
.form-item select:focus {
    border-color: #7c5ce0;
    background: #fff;
}

.image-upload-area {
    width: 100%;
    aspect-ratio: 1;
    border: 2px dashed #dddae6;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.2s;
    background: #faf9fd;
}

.image-upload-area:hover {
    border-color: #7c5ce0;
}

.image-upload-area img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.image-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #b5b0c8;
}

.image-placeholder i {
    font-size: 36px;
}

.image-placeholder span {
    font-size: 13px;
    font-weight: 500;
}

.btn-upload-small {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    justify-content: center;
    margin-top: 8px;
    background: #f0eef5;
    color: #6a4fc9;
    border: none;
    border-radius: 8px;
    padding: 8px 0;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: background 0.15s;
}

.btn-upload-small:hover {
    background: #e5e2ed;
}

.btn-save {
    background: linear-gradient(135deg, #7c5ce0 0%, #6a4fc9 100%);
    color: #fff;
    border: none;
    border-radius: 9px;
    padding: 10px 22px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
}

.btn-cancel {
    background: #f0eef5;
    color: #5e5a6e;
    border: none;
    border-radius: 9px;
    padding: 10px 22px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
}

.btn-cancel:hover {
    background: #e5e2ed;
}

.delete-modal-body {
    text-align: center;
    padding: 32px 24px !important;
}

.delete-icon {
    font-size: 40px;
    color: #e04848;
    margin-bottom: 12px;
}

.delete-modal-body h5 {
    font-weight: 700;
    font-size: 16px;
    margin-bottom: 8px;
}

.delete-message {
    font-size: 13px;
    color: #8b87a0;
    margin-bottom: 20px;
}

.delete-actions {
    display: flex;
    justify-content: center;
    gap: 10px;
}

.btn-delete {
    background: #e04848;
    color: #fff;
    border: none;
    border-radius: 9px;
    padding: 10px 22px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: background 0.15s;
}

.btn-delete:hover {
    background: #c83c3c;
}

.toast-container {
    z-index: 9999;
}

.custom-toast {
    min-width: 320px;
    border: none;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    overflow: hidden;
}

.custom-toast .toast-body {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    font-size: 14px;
    font-weight: 500;
    font-family: 'Inter', sans-serif;
    color: #fff;
}

.custom-toast .toast-body i {
    font-size: 18px;
}

.toast-success {
    background: linear-gradient(135deg, #22a854 0%, #1b8c45 100%);
}

.toast-error {
    background: linear-gradient(135deg, #e04848 0%, #c43838 100%);
}

.category-name-cell {
    font-weight: 600;
    color: #1e1e2d;
}

@media (max-width: 768px) {
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        transform: translateX(-100%);
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .sidebar-toggle {
        display: block;
    }

    .content-area {
        padding: 20px 16px;
    }

    .topbar {
        padding: 14px 16px;
    }

    .page-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
    }

    .filter-row {
        flex-direction: column;
    }

    .filter-actions {
        width: 100%;
    }

    .filter-actions button {
        flex: 1;
    }
}
